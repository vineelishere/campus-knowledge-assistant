# --- Database (host port 5433 -> container 5432, see docker-compose.yml) ---
DATABASE_URL=postgresql://campus:campus@localhost:5433/campus

# --- Runtime ---
# "production" makes the API refuse to start with a default JWT_SECRET.
ENVIRONMENT=development

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
# Failed login attempts allowed per email before a temporary 429.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# --- Answer LLM: pick ONE option ---
# Option A (default): Google Gemini through its OpenAI-compatible endpoint.
# Free key: aistudio.google.com/apikey -> paste into LLM_API_KEY.
# Only answer generation calls Gemini; embeddings and the reranker stay local and free.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Model names change often: pick a current one from ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-3.8-flash
# Optional: second model, tried when the main one stays overloaded or rate limited.
LLM_FALLBACK_MODEL=
# Gemini 3.x cannot disable thinking, so "low" keeps the reply inside LLM_MAX_TOKENS and returns
# whole JSON. Gemini 2.5 models may use "none" to switch thinking off completely.
LLM_MAX_TOKENS=2048
LLM_REASONING_EFFORT=low

# Option B: Ollama running locally (free, offline). Install from ollama.com, then: ollama pull qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# Option C: Groq (free API key from console.groq.com; check current limits/models there)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# Option D: Hugging Face Inference Providers. Free accounts get no monthly credits, so chat models
# need purchased credits. Leave LLM_BASE_URL empty to use it.
HF_TOKEN=
HF_PROVIDER=

# --- Embeddings: local (no API calls, no cost) or hf_api ---
EMBED_BACKEND=local
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# --- Reranker: local ---
RERANK_BACKEND=local
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval tuning (calibrate with the eval set) ---
CANDIDATES_PER_RETRIEVER=30
RERANK_TOP_N=6
# Raw cross-encoder score below which we answer "I do not know".
# 0.0 blocks all nine unanswerable questions in the bundled eval set. On that set -4.0 keeps
# 41/41 answerable and still blocks 9/9, but the gap is small and synthetic: re-run
# run_eval.py on YOUR documents and use its threshold sweep before changing this.
MIN_RERANK_SCORE=0.0

# --- Cost tracking (0 for free options) ---
INPUT_PRICE_PER_MTOK=0
OUTPUT_PRICE_PER_MTOK=0

# --- Langfuse tracing (optional; free cloud tier available) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000
